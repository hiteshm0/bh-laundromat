# Load this file in the shell that runs git push.
export LAUNDROMAT_PROVIDER='groq'
export GROQ_API_KEY='replace-with-your-groq-key'
export LAUNDROMAT_MODEL='openai/gpt-oss-20b'

# For OpenAI, use these three settings instead.
# export LAUNDROMAT_PROVIDER='openai'
# export OPENAI_API_KEY='replace-with-your-openai-key'
# export LAUNDROMAT_MODEL='replace-with-your-openai-model-id'
